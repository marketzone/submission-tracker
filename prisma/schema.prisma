// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String        @id @default(cuid())
  email            String        @unique
  name             String
  password         String        // hashed
  role             UserRole      @default(STUDENT)
  active                Boolean       @default(true) // For students: can be deactivated
  approved              Boolean       @default(false) // For approval workflow
  pendingDeactivation   Boolean       @default(false) // Flagged by cron, awaiting PM decision
  studentClass     StudentClass? // For students: assigned class
  launchStrategy   String?       // For students: launch format (Webinar, Workshop, etc.)
  launchPricing    String?       // For students: pricing model (FREE, PWYW, LOW_TICKET)
  launchPrice      String?       // For students: price if PWYW or Low Ticket
  launchEventTopic String?       // For students: content direction for launch event
  approvedEventTitle  String?     // Set by PM/coach after approval
  launchInfoStatus    String?     // null | PENDING_REVIEW | APPROVED | NEEDS_REVISION
  launchInfoFeedback  String?     // Head coach feedback when NEEDS_REVISION
  niche               String?     // Set by program manager (e.g. Level 5 Niche)
  resetToken       String?       // For password reset
  resetTokenExpiry DateTime?     // Token expiration time
  coachId          String?       // For students: their assigned coach
  coach            User?         @relation("CoachStudents", fields: [coachId], references: [id])
  students         User[]        @relation("CoachStudents")
  submissions      Submission[]      @relation("StudentSubmissions")
  coachReviews     Submission[]      @relation("CoachReviews")
  headCoachReviews Submission[]      @relation("HeadCoachReviews")
  strategyProgress StrategyProgress?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

enum UserRole {
  STUDENT
  COACH
  HEAD_COACH
  PROGRAM_MANAGER
}

enum StudentClass {
  PRE_CLARITY
  STRATEGY_CLASS
  FUNNEL_CLASS
  LAUNCH_CLASS
}

model StrategyProgress {
  id        String         @id @default(cuid())
  studentId String         @unique
  action    StrategyAction
  student   User           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([studentId])
}

enum StrategyAction {
  CANVA_SUBMITTED   // Canva images created & submitted in WhatsApp for coach review
  POST_APPROVED     // Can post approved by coach
  AD_SETUP_PENDING  // Ad setup waiting for metrics
  METRICS_READ      // Metrics read — ready for Week 2
}

model Submission {
  id                    String           @id @default(cuid())
  studentId             String
  student               User             @relation("StudentSubmissions", fields: [studentId], references: [id])
  workbookTitle         String
  workbookUrl           String
  weekNumber            Int              // 1-8
  coachId               String
  coach                 User             @relation("CoachReviews", fields: [coachId], references: [id])
  status                SubmissionStatus @default(PENDING)
  studentNote           String?          // Optional note from student to coach/head coach
  coachFeedback         String?
  headCoachId           String?
  headCoach             User?            @relation("HeadCoachReviews", fields: [headCoachId], references: [id])
  headCoachFeedback     String?
  returnedByHeadCoach   Boolean          @default(false) // True when head coach sent back to student
  submittedAt           DateTime         @default(now())
  reviewedAt            DateTime?        // Coach manual review timestamp (existing)
  headReviewedAt        DateTime?
  // AI review fields — parallel to manual review, never replaces it
  aiReviewStatus        AiReviewStatus   @default(PENDING)
  aiNicheAlignment      String?          // pass | drifting | off
  aiFeedback            Json?            // Full JSON output from the reviewer
  aiTriageVerdict       String?          // proceed | hold
  aiReviewedAt          DateTime?        // When AI processed this submission
  reviewModelVersion    String?          // e.g. "claude-opus-4-7"
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@index([studentId])
  @@index([coachId])
  @@index([status])
  @@index([aiReviewStatus])
}

enum SubmissionStatus {
  PENDING           // Initial submission
  COACH_REVIEW      // Coach is reviewing
  HEAD_COACH_REVIEW // Approved by coach, awaiting head coach
  APPROVED          // Final approval
  NEEDS_CORRECTION  // Coach or head coach requested changes
}

// ── Week criteria (AI reviewer rubric store) ─────────────────────────────────
// Static lookup table. One row per (week_number, launch_strategy, template_variant)
// combination. launch_strategy = null means the row applies to all strategies.
// template_variant distinguishes same-week deliverables (Week 3 ad_copy vs
// ad_video) and Week 6 sales-copy variants (long_form, desire_stack,
// three_step_even_if). See prisma/seed.ts for all 16 rows.
model WeekCriteria {
  id              String   @id @default(cuid())
  weekNumber      Int
  // 'free_event' | 'pwyw_or_low_ticket' | 'evergreen' | null (null = all strategies)
  launchStrategy  String?
  deliverableName String
  // Disambiguates deliverables within a week: 'aida' | 'storytelling' |
  // 'ad_copy' | 'ad_video' | 'long_form' | 'desire_stack' |
  // 'three_step_even_if' | 'webinar' | null
  templateVariant String?
  // Full verbatim pattern text from the rubric doc — up to ~5KB per row.
  // PostgreSQL TEXT has no size limit; Prisma String maps to TEXT.
  templatePattern String
  sourceDocUrl    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([weekNumber, launchStrategy])
  @@map("week_criteria")
}

// ── AI review status ──────────────────────────────────────────────────────────
// Runs in parallel with the manual review workflow. PENDING = not yet reviewed
// by AI. AUTO_APPROVED = AI verdict proceed, no human review needed.
// HELD_FOR_HUMAN = AI flagged for Mayowa's review. HUMAN_REVIEWED = Mayowa
// has reviewed the AI output and taken action.
enum AiReviewStatus {
  PENDING
  AUTO_APPROVED
  HELD_FOR_HUMAN
  HUMAN_REVIEWED
}
